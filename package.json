{
  "name": "calca",
  "version": "0.7.0",
  "private": true,
  "description": "AI design tool with infinite canvas — vibe coding for design",
  "license": "AGPL-3.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "platforms/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "build:app": "turbo run build:app --filter=@app/web && rm -rf apps/landing/dist/app && cp -r apps/web/dist apps/landing/dist/app",
    "build:docs": "docmd build",
    "check:canvas-boundaries": "bun scripts/check-canvas-boundaries.ts",
    "build:desktop": "bun run --cwd platforms/desktop build:desktop",
    "clean": "turbo clean",
    "dev": "turbo dev",
    "dev:landing": "bun run --cwd apps/landing dev:landing",
    "dev:desktop": "bun run --cwd platforms/desktop dev:desktop",
    "start": "turbo start",
    "format": "turbo format",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:e2e": "GAUGE_TS_PACKAGE_RUNNER=bun STEP_IMPL_DIR=steps,support gauge run e2e/specs",
    "test:e2e:spec": "GAUGE_TS_PACKAGE_RUNNER=bun STEP_IMPL_DIR=steps,support gauge run",
    "typecheck": "turbo typecheck",
    "validate": "bun scripts/validate.ts",
    "validate:quick": "bun scripts/validate.ts --quick",
    "check:manifests": "bun scripts/check-workspace-manifests.ts",
    "postinstall": "bun scripts/install-git-hooks.ts",
    "check:knip": "knip"
  },
  "dependencies": {
    "@ai-sdk/provider-utils": "^4.0.23",
    "@inlang/paraglide-js-adapter-vite": "^1.2.40",
    "type-fest": "^5.6.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@commitlint/types": "^20.5.0",
    "@docmd/core": "^0.9.7",
    "@getgauge/cli": "^1.6.38",
    "@types/bun": "^1.3.13",
    "@types/react-dom": "^19.2.3",
    "agent-browser": "^0.38.2",
    "gauge-ts": "^0.5.1",
    "jsdom": "^29.0.2",
    "knip": "^6.39.0",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "ts-node": "^10.9.2",
    "turbo": "^2.4.0",
    "unrun": "^0.3.1",
    "vitest": "catalog:"
  },
  "overrides": {
    "@opentelemetry/resources": "1.29.0",
    "@opentelemetry/sdk-metrics": "1.29.0",
    "@opentelemetry/sdk-trace-node": "1.29.0",
    "@tanstack/router-generator": {
      "zod": "^3.24.0"
    },
    "@tanstack/router-plugin": {
      "zod": "^3.24.0"
    },
    "ai": "^7.0.0",
    "astro": {
      "zod": "^3.24.0"
    },
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "zod": "^4.4.3",
    "zod-to-ts": {
      "zod": "^3.24.0"
    }
  },
  "simple-git-hooks": {
    "commit-msg": "bunx commitlint --edit $1",
    "pre-push": "bun run validate:quick"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "packageManager": "bun@1.4.2",
  "catalogs": {
    "default": {
      "ai": "^7.0.0",
      "oxfmt": "^0.57.0",
      "oxlint": "^1.72.0",
      "typescript": "^6.0.3",
      "vitest": "^4.1.5",
      "zod": "^4.4.3"
    }
  }
}
