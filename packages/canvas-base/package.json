{
  "name": "@calca/canvas-base",
  "version": "0.6.1",
  "private": false,
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "bunx tsc --noEmit",
    "lint": "oxlint --fix .",
    "format": "oxfmt --write .",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "validate": "bun ../../scripts/validate.ts --cwd $INIT_CWD",
    "check:pack": "publint && attw --pack . --profile esm-only"
  },
  "dependencies": {},
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.0",
    "@standard-schema/spec": "^1.0.0",
    "publint": "^0.3.0",
    "tsdown": "^0.23.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
