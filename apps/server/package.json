{
  "name": "@app/server",
  "version": "0.7.5",
  "private": true,
  "license": "AGPL-3.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun dist/index.js",
    "build": "tsc",
    "build:sw": "bun build src/sw.ts --outfile dist/sw.js --target browser --minify",
    "typecheck": "bunx tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "oxlint --fix .",
    "format": "oxfmt --write .",
    "clean": "rm -rf dist",
    "validate": "bun ../../scripts/validate.ts --cwd $INIT_CWD"
  },
  "dependencies": {
    "@app/core": "workspace:*",
    "@app/logger": "workspace:*",
    "@app/shared": "workspace:*",
    "@calca/pipeline": "workspace:*",
    "@hono/node-server": "^1.19.14",
    "@openfeature/server-sdk": "^1.20.2",
    "ai": "catalog:",
    "hono": "^4.12.14",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "^1.3.12",
    "@types/node": "^25.2.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
