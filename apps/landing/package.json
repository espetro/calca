{
  "name": "@app/landing",
  "version": "0.6.1",
  "private": true,
  "license": "AGPL-3.0",
  "type": "module",
  "scripts": {
    "dev:landing": "astro dev",
    "build": "astro build && bun run build:app",
    "build:app": "cd ../web && bunx vite build --base=/app/ && rm -rf ../landing/dist/app && cp -r dist ../landing/dist/app",
    "typecheck": "astro check",
    "preview": "astro preview",
    "test": "vitest run --passWithNoTests",
    "lint": "oxlint --fix .",
    "format": "oxfmt --write .",
    "clean": "rm -rf dist",
    "validate": "bun ../../scripts/validate.ts --cwd $INIT_CWD"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/react": "^4.2.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^5.2.0",
    "posthog-js": "^1.372.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.6.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "catalog:"
  }
}
